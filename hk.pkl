amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

fail_fast = false
env {
  ["HK_MISE"] = "1"
}

steps {
  ["packer"] = new Step {
    glob = "*.pkr.hcl"
    check = "packer fmt -check {{ files }}"
    fix = "packer fmt {{ files }}"
  }

  ["zsh"] = new Step {
    glob = "*.zsh"
    check = "for file in {{ files }}; do zsh --noexec \"$file\" || exit $?; done"
  }

  // Builtins
  ["actionlint"] = Builtins.actionlint
  ["editorconfig-checker"] = Builtins.editorconfig_checker
  ["mise"] = Builtins.mise
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["ryl"] = Builtins.ryl
  ["shellcheck"] = Builtins.shellcheck
  ["tombi"] = Builtins.tombi

  ["ls-lint"] = (Builtins.ls_lint) {
    check {
      command {
        argv = Builtins.ls_lint.check.command.argv + List("-config", ".config/ls-lint.yml")
      }
    }
  }
  ["lychee"] = (Builtins.lychee) {
    exclude = "mise.lock"
    check {
      command {
        argv = Builtins.lychee.check.command.argv + List("--config", ".config/lychee.toml")
      }
    }
  }
  ["shfmt"] = (Builtins.shfmt) {
    // shfmt cannot parse zsh try/always blocks: https://github.com/mvdan/sh/issues/1211
    exclude = "scripts/update-hk-import.zsh"
  }

  // Utilities
  ["byte-order-marker"] = Builtins.byte_order_marker
  ["check-added-large-files"] = Builtins.check_added_large_files
  ["check-case-conflict"] = Builtins.check_case_conflict
  ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["check-symlinks"] = Builtins.check_symlinks
  ["destroyed_symlinks"] = Builtins.destroyed_symlinks
  ["detect-private-key"] = Builtins.detect_private_key
  ["fix-smart-quotes"] = Builtins.fix_smart_quotes
  ["forbid-submodules"] = Builtins.forbid_submodules
  ["mixed-line-ending"] = Builtins.mixed_line_ending
  ["newlines"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace
}
